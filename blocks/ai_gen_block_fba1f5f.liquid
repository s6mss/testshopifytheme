</social-icons-{{ ai_gen_id }}>

<script>
  (function() {
    class SocialIcons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.detectSocialNetworks();
      }

      detectSocialNetworks() {
        const links = this.querySelectorAll('.ai-social-icon-{{ ai_gen_id }}');
        
        links.forEach(link => {
          const url = link.getAttribute('href');
          if (!url) return;

          const urlLower = url.toLowerCase();
          let detectedNetwork = null;

          if (urlLower.includes('facebook.com') || urlLower.includes('fb.com')) {
            detectedNetwork = 'facebook';
          } else if (urlLower.includes('instagram.com')) {
            detectedNetwork = 'instagram';
          } else if (urlLower.includes('youtube.com') || urlLower.includes('youtu.be')) {
            detectedNetwork = 'youtube';
          } else if (urlLower.includes('tiktok.com')) {
            detectedNetwork = 'tiktok';
          } else if (urlLower.includes('twitter.com') || urlLower.includes('x.com')) {
            detectedNetwork = 'twitter';
          } else if (urlLower.includes('snapchat.com')) {
            detectedNetwork = 'snapchat';
          } else if (urlLower.includes('pinterest.com')) {
            detectedNetwork = 'pinterest';
          } else if (urlLower.includes('tumblr.com')) {
            detectedNetwork = 'tumblr';
          } else if (urlLower.includes('vimeo.com')) {
            detectedNetwork = 'vimeo';
          }

          if (detectedNetwork) {
            link.setAttribute('data-network', detectedNetwork);
          }
        });
      }
    }

    customElements.define('social-icons-{{ ai_gen_id }}', SocialIcons{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Social media icons",
  "settings": [
    {
      "type": "header",
      "content": "Social networks"
    },
    {
      "type": "url",
      "id": "social_facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "social_tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_twitter_url",
      "label": "Twitter URL"
    },
    {
      "type": "url",
      "id": "social_snapchat_url",
      "label": "Snapchat URL"
    },
    {
      "type": "url",
      "id": "social_pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "social_tumblr_url",
