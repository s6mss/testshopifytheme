{% doc %}
  @prompt
    social media icons that can be resized, and automatically show the logo of the social network upon me pasting in the URL. They can be resized, and the whole section is very customisable.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-social-icons-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-social-icons-container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.icon_spacing }}px;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
  }

  .ai-social-icon-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    transition: all 0.3s ease;
    text-decoration: none;
    border: {{ block.settings.icon_border_width }}px solid {{ block.settings.icon_border_color }};
  }

  .ai-social-icon-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.icon_hover_background_color }};
    transform: translateY(-2px);
  }

  .ai-social-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size | times: 0.5 }}px;
    height: {{ block.settings.icon_size | times: 0.5 }}px;
    fill: {{ block.settings.icon_color }};
    transition: fill 0.3s ease;
  }

  .ai-social-icon-{{ ai_gen_id }}:hover svg {
    fill: {{ block.settings.icon_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-social-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .ai-social-icon-{{ ai_gen_id }} svg {
      width: {{ block.settings.mobile_icon_size | times: 0.5 }}px;
      height: {{ block.settings.mobile_icon_size | times: 0.5 }}px;
    }

    .ai-social-icons-container-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_icon_spacing }}px;
    }
  }
{% endstyle %}

<social-icons-{{ ai_gen_id }} class="ai-social-icons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-social-icons-container-{{ ai_gen_id }}">
    {% liquid
      assign social_networks = 'facebook,instagram,youtube,tiktok,twitter,snapchat,pinterest,tumblr,vimeo' | split: ','
      assign social_labels = 'Facebook,Instagram,YouTube,TikTok,Twitter,Snapchat,Pinterest,Tumblr,Vimeo' | split: ','
    %}

    {% for network in social_networks %}
      {% assign setting_key = 'social_' | append: network | append: '_url' %}
      {% assign social_url = block.settings[setting_key] %}
      
      {% if social_url != blank %}
        {% assign index = forloop.index0 %}
        {% assign label = social_labels[index] %}
        
        <a 
          href="{{ social_url }}" 
          class="ai-social-icon-{{ ai_gen_id }}" 
          target="_blank" 
          rel="noopener noreferrer"
          aria-label="{{ label }}"
        >
