  <div class="ai-affiliate-hub__loading-{{ ai_gen_id }}" data-loading>
    <div class="ai-affiliate-hub__spinner-{{ ai_gen_id }}"></div>
    {{ block.settings.loading_text }}
  </div>

  <div class="ai-affiliate-hub__dashboard-{{ ai_gen_id }}" data-dashboard>
    <div class="ai-affiliate-hub__dashboard-header-{{ ai_gen_id }}">
      <h3 class="ai-affiliate-hub__dashboard-title-{{ ai_gen_id }}">{{ block.settings.dashboard_title }}</h3>
      <p class="ai-affiliate-hub__dashboard-subtitle-{{ ai_gen_id }}">{{ block.settings.dashboard_subtitle }}</p>
    </div>

    <div class="ai-affiliate-hub__stats-grid-{{ ai_gen_id }}">
      <div class="ai-affiliate-hub__stat-card-{{ ai_gen_id }}">
        <div class="ai-affiliate-hub__stat-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </div>
        <div class="ai-affiliate-hub__stat-label-{{ ai_gen_id }}">Total Views</div>
        <div class="ai-affiliate-hub__stat-value-{{ ai_gen_id }}" data-stat-views>10</div>
      </div>

      <div class="ai-affiliate-hub__stat-card-{{ ai_gen_id }}">
        <div class="ai-affiliate-hub__stat-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
        </div>
        <div class="ai-affiliate-hub__stat-label-{{ ai_gen_id }}">Sales</div>
        <div class="ai-affiliate-hub__stat-value-{{ ai_gen_id }}" data-stat-sales>0</div>
      </div>

      <div class="ai-affiliate-hub__stat-card-{{ ai_gen_id }}">
        <div class="ai-affiliate-hub__stat-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
        <div class="ai-affiliate-hub__stat-label-{{ ai_gen_id }}">Click Rate</div>
        <div class="ai-affiliate-hub__stat-value-{{ ai_gen_id }}" data-stat-rate>8.5%</div>
      </div>

      <div class="ai-affiliate-hub__stat-card-{{ ai_gen_id }}">
        <div class="ai-affiliate-hub__stat-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"/>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
