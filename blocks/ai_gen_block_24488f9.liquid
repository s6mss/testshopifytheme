    <div class="ai-affiliate-hub__chart-container-{{ ai_gen_id }}">
      <h3 class="ai-affiliate-hub__chart-title-{{ ai_gen_id }}">{{ block.settings.chart_title }}</h3>
      <div class="ai-affiliate-hub__chart-{{ ai_gen_id }}" data-chart>
      </div>
    </div>
  </div>
</affiliate-hub-{{ ai_gen_id }}>

<script>
  (function() {
    class AffiliateHub{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.trackButton = this.querySelector('[data-track-button]');
        this.loadingElement = this.querySelector('[data-loading]');
        this.dashboard = this.querySelector('[data-dashboard]');
        this.affiliateInput = this.querySelector('[data-affiliate-input]');
        this.chart = this.querySelector('[data-chart]');
        this.loadingDuration = {{ block.settings.loading_duration }} * 1000;
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.trackButton.addEventListener('click', () => {
          this.handleSubmit();
        });

        this.affiliateInput.addEventListener('keypress', (e) => {
          if (e.key === 'Enter') {
            this.handleSubmit();
          }
        });
      }

      handleSubmit() {
        const inputValue = this.affiliateInput.value.trim();
        
        if (!inputValue) {
          this.affiliateInput.focus();
          return;
        }

        this.trackButton.style.display = 'none';
        this.loadingElement.classList.add('active');

        setTimeout(() => {
          this.loadingElement.classList.remove('active');
          this.dashboard.classList.add('active');
          this.renderChart();
        }, this.loadingDuration);
      }

      renderChart() {
        const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
        const values = [2, 4, 1, 3, 0, 0, 0];
        const maxValue = Math.max(...values);

        this.chart.innerHTML = '';

        days.forEach((day, index) => {
          const value = values[index];
          const height = maxValue > 0 ? (value / maxValue) * 100 : 0;

          const wrapper = document.createElement('div');
          wrapper.className = 'ai-affiliate-hub__bar-wrapper-{{ ai_gen_id }}';

          const bar = document.createElement('div');
          bar.className = 'ai-affiliate-hub__bar-{{ ai_gen_id }}';
          bar.style.height = height + '%';

          const barValue = document.createElement('div');
          barValue.className = 'ai-affiliate-hub__bar-value-{{ ai_gen_id }}';
          barValue.textContent = value;

          const label = document.createElement('div');
          label.className = 'ai-affiliate-hub__bar-label-{{ ai_gen_id }}';
          label.textContent = day;

          bar.appendChild(barValue);
          wrapper.appendChild(bar);
          wrapper.appendChild(label);
          this.chart.appendChild(wrapper);
        });
      }
    }

    customElements.define('affiliate-hub-{{ ai_gen_id }}', AffiliateHub{{ ai_gen_id }});
  })();
</script>

