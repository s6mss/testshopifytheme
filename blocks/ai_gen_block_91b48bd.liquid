{% doc %}
  @prompt
    I need a collection that basically has the option to select what products to show, I can show 2 columns (2 products) alongside eachother on mobile, or just one. Also, it gives the option to pick variant and quantity, and below add to cart. Variant and quantity are alongside eachother (2 rows) in the UI., can you make it so I can resize the variant and quantity parts. also make the add to cart trigger the theme default., Make the add to cart button actually work and not have errors. Give me the option to resize the variant and quantity boxes., I need the add to cart button to be aligned properly, not overlaying the variant and quantity part. Also, it doesn't currently add items to cart when pressed. Please fix that, Now give the option for price to automatically show inside the buy now button
    Allow up for 20 products to be selected.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-collection-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 20px;
  }

  .ai-product-collection__grid-{{ ai_gen_id }} {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
  }

  @media screen and (min-width: 750px) {
    .ai-product-collection__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ai-product-collection__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
  }

  .ai-product-collection__image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
  }

  .ai-product-collection__title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-collection__price-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    color: {{ block.settings.price_color }};
    margin: 0;
  }

  .ai-product-collection__controls-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ block.settings.variant_width }}% {{ block.settings.quantity_width }}%;
    gap: 8px;
    margin-top: 8px;
  }

  .ai-product-collection__variant-{{ ai_gen_id }},
  .ai-product-collection__quantity-{{ ai_gen_id }} {
    padding: 10px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    font-size: 14px;
    width: 100%;
  }

  .ai-product-collection__add-to-cart-{{ ai_gen_id }} {
    margin-top: 12px;
    width: 100%;
    padding: 14px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-collection__add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-product-collection__add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-product-collection__price-in-button-{{ ai_gen_id }} {
    font-weight: 700;
    margin-left: 8px;
  }
{% endstyle %}

<product-collection-{{ ai_gen_id }} class="ai-product-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-collection__grid-{{ ai_gen_id }}">
    {% for i in (1..20) %}
      {% liquid
        assign product_key = 'product_' | append: i
        assign product = block.settings[product_key]
      %}

      {% if product != blank %}
        <div class="ai-product-collection__item-{{ ai_gen_id }}">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 500 }}"
              alt="{{ product.featured_image.alt | escape }}"
              class="ai-product-collection__image-{{ ai_gen_id }}"
              loading="lazy"
              width="500"
              height="500"
            >
          {% endif %}

          <h3 class="ai-product-collection__title-{{ ai_gen_id }}">{{ product.title }}</h3>

          {% unless block.settings.show_price_in_button %}
            <div class="ai-product-collection__price-{{ ai_gen_id }}" data-product-price="{{ i }}">
              {{ product.price | money }}
            </div>
          {% endunless %}

          <div class="ai-product-collection__controls-{{ ai_gen_id }}">
            {% if product.has_only_default_variant %}
              <input type="hidden" data-variant-select="{{ i }}" value="{{ product.selected_or_first_available_variant.id }}">
            {% else %}
              <select class="ai-product-collection__variant-{{ ai_gen_id }}" data-variant-select="{{ i }}" data-product-id="{{ product.id }}">
                {% for variant in product.variants %}
                  <option 
                    value="{{ variant.id }}" 
                    {% unless variant.available %}disabled{% endunless %}
                    data-price="{{ variant.price }}"
                  >
                    {{ variant.title }}{% unless variant.available %} - Sold Out{% endunless %}
                  </option>
                {% endfor %}
              </select>
            {% endif %}

            <input
              type="number"
              class="ai-product-collection__quantity-{{ ai_gen_id }}"
              data-quantity-input="{{ i }}"
              value="1"
              min="1"
              aria-label="Quantity"
            >
          </div>

          <button
            class="ai-product-collection__add-to-cart-{{ ai_gen_id }}"
            data-add-to-cart="{{ i }}"
            data-product-id="{{ product.id }}"
            type="button"
          >
            Add to Cart
            {% if block.settings.show_price_in_button %}
              <span class="ai-product-collection__price-in-button-{{ ai_gen_id }}" data-button-price="{{ i }}">
                {{ product.price | money }}
              </span>
            {% endif %}
          </button>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</product-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.showPriceInButton = {{ block.settings.show_price_in_button | json }};
      }

      connectedCallback() {
        this.variantSelects = this.querySelectorAll('[data-variant-select]');
        this.addToCartButtons = this.querySelectorAll('[data-add-to-cart]');
        
        this.variantSelects.forEach((select) => {
          select.addEventListener('change', this.handleVariantChange.bind(this));
        });

        this.addToCartButtons.forEach((button) => {
          button.addEventListener('click', this.handleAddToCart.bind(this));
        });
      }

      handleVariantChange(event) {
        const select = event.target;
        const index = select.dataset.variantSelect;
        const selectedOption = select.options[select.selectedIndex];
        const price = selectedOption.dataset.price;

        if (price) {
          const formattedPrice = this.formatMoney(price);
          
          if (this.showPriceInButton) {
            const buttonPrice = this.querySelector(`[data-button-price="${index}"]`);
            if (buttonPrice) {
              buttonPrice.textContent = formattedPrice;
            }
          } else {
            const priceElement = this.querySelector(`[data-product-price="${index}"]`);
            if (priceElement) {
              priceElement.textContent = formattedPrice;
            }
          }
        }
      }

      async handleAddToCart(event) {
        const button = event.target;
        const index = button.dataset.addToCart;
        const variantSelect = this.querySelector(`[data-variant-select="${index}"]`);
        const quantityInput = this.querySelector(`[data-quantity-input="${index}"]`);

        if (!variantSelect || !quantityInput) return;

        const variantId = variantSelect.value;
        const quantity = parseInt(quantityInput.value, 10);

        if (!variantId || quantity < 1) return;

        button.disabled = true;
        const originalText = button.innerHTML;
        button.textContent = 'Adding...';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: [{
                id: variantId,
                quantity: quantity
              }]
            })
          });

          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }

          const data = await response.json();
          
          button.innerHTML = '✓ Added!';
          
          setTimeout(() => {
            button.innerHTML = originalText;
            button.disabled = false;
          }, 2000);

          document.dispatchEvent(new CustomEvent('cart:refresh'));
          
          if (window.theme && window.theme.cart) {
            window.theme.cart.refresh();
          }

          const cartDrawer = document.querySelector('cart-drawer');
          if (cartDrawer && typeof cartDrawer.open === 'function') {
            cartDrawer.open();
          }

        } catch (error) {
          console.error('Error adding to cart:', error);
          button.innerHTML = 'Error - Try Again';
          setTimeout(() => {
            button.innerHTML = originalText;
            button.disabled = false;
          }, 2000);
        }
      }

      formatMoney(cents) {
        const amount = parseFloat(cents) / 100;
        return new Intl.NumberFormat('en-GB', {
          style: 'currency',
          currency: 'GBP'
        }).format(amount);
      }
    }

    customElements.define('product-collection-{{ ai_gen_id }}', ProductCollection{{ ai_gen_id }});
  })();
</script>

