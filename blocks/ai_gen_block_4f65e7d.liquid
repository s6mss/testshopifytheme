    padding: 24px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: 2px solid {{ block.settings.payout_border_color }};
  }

  .ai-affiliate-hub__payout-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin-bottom: 16px;
