    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 15px;
    outline: none;
  }

  .ai-affiliate-hub__payout-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 24px;
    background: {{ block.settings.payout_button_bg }};
    color: {{ block.settings.payout_button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-affiliate-hub__payout-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.payout_button_hover_bg }};
  }

  .ai-affiliate-hub__payout-success-{{ ai_gen_id }} {
    display: none;
    padding: 12px;
    background: {{ block.settings.success_bg_color }};
    color: {{ block.settings.success_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
