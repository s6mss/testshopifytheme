<script>
  (function() {
    class AffiliateHub{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.affiliateData = {};
        this.storageKey = 'affiliateHub_{{ ai_gen_id }}_data';
      }

      connectedCallback() {
        this.input = this.querySelector('[data-affiliate-input]');
        this.trackButton = this.querySelector('[data-track-button]');
        this.loading = this.querySelector('[data-loading]');
        this.dashboard = this.querySelector('[data-dashboard]');
        this.errorMessage = this.querySelector('[data-error-message]');
        this.payoutButton = this.querySelector('[data-payout-button]');
        this.payoutSuccess = this.querySelector('[data-payout-success]');
        this.accountInput = this.querySelector('[data-account-input]');
        this.sortcodeInput = this.querySelector('[data-sortcode-input]');

        this.loadStoredData();
        this.setupEventListeners();
      }

      loadStoredData() {
        const stored = localStorage.getItem(this.storageKey);
        if (stored) {
          try {
            this.affiliateData = JSON.parse(stored);
            if (this.affiliateData.code) {
              this.input.value = this.affiliateData.code;
              this.showDashboard();
              if (this.affiliateData.accountNumber && this.affiliateData.sortCode) {
                this.accountInput.value = this.affiliateData.accountNumber;
                this.sortcodeInput.value = this.affiliateData.sortCode;
                this.payoutSuccess.classList.add('active');
              }
            }
          } catch (e) {
            console.error('Error loading affiliate data:', e);
          }
        }
      }

      saveData() {
        localStorage.setItem(this.storageKey, JSON.stringify(this.affiliateData));
      }

      setupEventListeners() {
        this.trackButton.addEventListener('click', () => this.handleTrackClick());
        this.payoutButton.addEventListener('click', () => this.handlePayoutClick());

        const chartBars = this.querySelectorAll('[data-day]');
        chartBars.forEach(bar => {
          bar.addEventListener('click', function(e) {
            const day = e.target.getAttribute('data-day');
            alert('Views on ' + day + ': ' + Math.floor(Math.random() * 20 + 5));
          });
        });
      }

      handleTrackClick() {
        const code = this.input.value.trim();
        
        if (!code) {
          this.showError('Please enter your affiliate code');
          return;
        }

        this.errorMessage.classList.remove('active');
        this.affiliateData.code = code;
        this.saveData();

        this.trackButton.disabled = true;
        this.loading.classList.add('active');

        setTimeout(() => {
          this.loading.classList.remove('active');
          this.showDashboard();
          this.trackButton.disabled = false;
        }, {{ block.settings.loading_duration | times: 1000 }});
      }

      showDashboard() {
        this.dashboard.classList.add('active');
      }

      showError(message) {
        this.errorMessage.textContent = message;
        this.errorMessage.classList.add('active');
      }

      handlePayoutClick() {
        const accountNumber = this.accountInput.value.trim();
        const sortCode = this.sortcodeInput.value.trim();

        if (!accountNumber || !sortCode) {
          alert('Please enter both account number and sort code');
          return;
        }

        this.affiliateData.accountNumber = accountNumber;
        this.affiliateData.sortCode = sortCode;
        this.saveData();

        this.payoutSuccess.classList.add('active');
      }
    }

    customElements.define('affiliate-hub-{{ ai_gen_id }}', AffiliateHub{{ ai_gen_id }});
  })();
</script>

