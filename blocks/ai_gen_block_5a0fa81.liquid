{% doc %}
  @prompt
    a slider that is controlled on mobile / desktop by scrolling horizontally. on mobile 2 columns are allowed, on desktop up to 5. up to 20 products can pre-fill this selection. it enables the custom to add other products to cart, with a variant and quantity selector above on the same line, above the add to cart, price shown also, size and amount of row variant/quantity selectors take up is also changeable, can you make it so there can be 2-5 columns selected for both mobile and pc. also, make sure that the variants and quantity are both selectable for users. and it must be nice and compact. with a title option.
    
    Can you make the images 1x1
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 20px 0;
  }

  .ai-product-slider-title-{{ ai_gen_id }} {
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 20px;
    text-align: {{ block.settings.title_alignment }};
    color: {{ block.settings.title_color }};
  }

  .ai-product-slider-container-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
  }

  .ai-product-slider-container-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 8px;
  }

  .ai-product-slider-container-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .ai-product-slider-container-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: {{ block.settings.scrollbar_color }};
    border-radius: 4px;
  }

  .ai-product-slider-grid-{{ ai_gen_id }} {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - ({{ block.settings.columns_mobile | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.columns_mobile }});
    gap: {{ block.settings.gap }}px;
    padding-bottom: 10px;
  }

  @media screen and (min-width: 750px) {
    .ai-product-slider-grid-{{ ai_gen_id }} {
      grid-auto-columns: calc((100% - ({{ block.settings.columns_desktop | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.columns_desktop }});
    }
  }

  .ai-product-slider-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-product-slider-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    margin-bottom: 12px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-slider-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-slider-title-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    color: {{ block.settings.product_title_color }};
    line-height: 1.3;
  }

  .ai-product-slider-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 700;
    margin-bottom: 12px;
    color: {{ block.settings.price_color }};
  }

  .ai-product-slider-selectors-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.selector_gap }}px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .ai-product-slider-selector-wrapper-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-product-slider-selector-label-{{ ai_gen_id }} {
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 4px;
    display: block;
    color: {{ block.settings.label_color }};
    text-transform: uppercase;
  }

  .ai-product-slider-select-{{ ai_gen_id }} {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid {{ block.settings.selector_border_color }};
    border-radius: {{ block.settings.selector_border_radius }}px;
    background-color: {{ block.settings.selector_background }};
    color: {{ block.settings.selector_text_color }};
    font-size: 13px;
    cursor: pointer;
  }

  .ai-product-slider-quantity-wrapper-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.quantity_width }}px;
  }

  .ai-product-slider-quantity-{{ ai_gen_id }} {
    width: 100%;
    padding: 8px 6px;
    border: 1px solid {{ block.settings.selector_border_color }};
    border-radius: {{ block.settings.selector_border_radius }}px;
    background-color: {{ block.settings.selector_background }};
    color: {{ block.settings.selector_text_color }};
    font-size: 13px;
    text-align: center;
  }

  .ai-product-slider-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-slider-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-product-slider-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-product-slider-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #999;
    font-size: 14px;
  }
{% endstyle %}

<product-slider-{{ ai_gen_id }} class="ai-product-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-product-slider-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
  {% endif %}

  {% assign has_products = false %}
  {% for i in (1..20) %}
    {% assign product_key = 'product_' | append: i %}
    {% if block.settings[product_key] != blank %}
      {% assign has_products = true %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if has_products %}
    <div class="ai-product-slider-container-{{ ai_gen_id }}">
      <div class="ai-product-slider-grid-{{ ai_gen_id }}">
        {% for i in (1..20) %}
          {% assign product_key = 'product_' | append: i %}
          {% assign product = block.settings[product_key] %}
          
          {% if product != blank %}
            <div class="ai-product-slider-item-{{ ai_gen_id }}">
              <div class="ai-product-slider-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-product-slider-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="400"
                    height="400"
                  >
                {% else %}
                  <div class="ai-product-slider-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <h3 class="ai-product-slider-title-text-{{ ai_gen_id }}">{{ product.title }}</h3>
              
              <div class="ai-product-slider-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>

              <div class="ai-product-slider-selectors-{{ ai_gen_id }}">
                {% if product.has_only_default_variant %}
                  <input type="hidden" data-variant-id="{{ product.selected_or_first_available_variant.id }}">
                {% else %}
                  <div class="ai-product-slider-selector-wrapper-{{ ai_gen_id }}">
                    <label class="ai-product-slider-selector-label-{{ ai_gen_id }}">
                      {{ block.settings.variant_label }}
                    </label>
                    <select class="ai-product-slider-select-{{ ai_gen_id }}" data-variant-select>
                      {% for variant in product.variants %}
                        <option 
                          value="{{ variant.id }}" 
                          {% unless variant.available %}disabled{% endunless %}
                        >
                          {{ variant.title }}{% unless variant.available %} - Sold Out{% endunless %}
                        </option>
                      {% endfor %}
                    </select>
                  </div>
                {% endif %}

                <div class="ai-product-slider-quantity-wrapper-{{ ai_gen_id }}">
                  <label class="ai-product-slider-selector-label-{{ ai_gen_id }}">
                    {{ block.settings.quantity_label }}
                  </label>
                  <input 
                    type="number" 
                    class="ai-product-slider-quantity-{{ ai_gen_id }}" 
                    value="1" 
                    min="1" 
                    max="99"
                    data-quantity-input
                  >
                </div>
              </div>

              <button 
                class="ai-product-slider-button-{{ ai_gen_id }}" 
                data-add-to-cart
                data-product-id="{{ product.id }}"
              >
                {{ block.settings.button_text }}
              </button>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="ai-product-slider-empty-{{ ai_gen_id }}">
      Add products to display in the slider
    </div>
  {% endif %}
</product-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-product-slider-item-{{ ai_gen_id }}');
        this.setupAddToCart();
      }

      setupAddToCart() {
        this.items.forEach((item) => {
          const button = item.querySelector('[data-add-to-cart]');
          const variantSelect = item.querySelector('[data-variant-select]');
          const quantityInput = item.querySelector('[data-quantity-input]');
          const hiddenVariantInput = item.querySelector('[data-variant-id]');

          if (!button) return;

          button.addEventListener('click', async () => {
            let variantId;
            
            if (hiddenVariantInput) {
              variantId = hiddenVariantInput.dataset.variantId;
            } else if (variantSelect) {
              variantId = variantSelect.value;
            }

            const quantity = quantityInput ? parseInt(quantityInput.value) : 1;

            if (!variantId) return;

            button.disabled = true;
            const originalText = button.textContent;
            button.textContent = 'Adding...';

            try {
              const response = await fetch('/cart/add.js', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  items: [{
                    id: variantId,
                    quantity: quantity
                  }]
                })
              });

              if (response.ok) {
                button.textContent = 'Added!';
                
                if (window.theme && window.theme.cart) {
                  window.theme.cart.refresh();
                }
                
                document.dispatchEvent(new CustomEvent('cart:refresh'));
                
                setTimeout(() => {
                  button.textContent = originalText;
                  button.disabled = false;
                }, 2000);
              } else {
                throw new Error('Failed to add to cart');
              }
            } catch (error) {
              console.error('Error adding to cart:', error);
              button.textContent = 'Error';
              setTimeout(() => {
                button.textContent = originalText;
                button.disabled = false;
              }, 2000);
            }
          });
        });
      }
    }

    customElements.define('product-slider-{{ ai_gen_id }}', ProductSlider{{ ai_gen_id }});
  })();
</script>

