</affiliate-hub-{{ ai_gen_id }}>

<script>
  (function() {
    class AffiliateHub{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.affiliateInput = this.querySelector('[data-affiliate-input]');
        this.trackButton = this.querySelector('[data-track-button]');
        this.loadingSection = this.querySelector('[data-loading]');
        this.dashboard = this.querySelector('[data-dashboard]');
        this.inputSection = this.querySelector('.ai-affiliate-hub__input-section-{{ ai_gen_id }}');
        this.accountInput = this.querySelector('[data-account-input]');
        this.sortcodeInput = this.querySelector('[data-sortcode-input]');
        this.payoutSaved = this.querySelector('[data-payout-saved]');
        this.chart = this.querySelector('[data-chart]');
        this.chartLabels = this.querySelector('[data-chart-labels]');
        
        this.storageKey = 'affiliateHub_{{ ai_gen_id }}';
      }

      connectedCallback() {
        this.setupEventListeners();
        this.loadSavedData();
      }

      setupEventListeners() {
        this.trackButton.addEventListener('click', () => this.handleTrackStats());
        this.accountInput.addEventListener('input', () => this.handlePayoutInput());
        this.sortcodeInput.addEventListener('input', () => this.handlePayoutInput());
        this.affiliateInput.addEventListener('keypress', (e) => {
          if (e.key === 'Enter') {
            this.handleTrackStats();
          }
        });
      }

      loadSavedData() {
        const affiliateCode = this.affiliateInput.value.trim();
        if (affiliateCode) {
          const savedData = this.getStoredData(affiliateCode);
          if (savedData && savedData.account && savedData.sortcode) {
            this.accountInput.value = savedData.account;
            this.sortcodeInput.value = savedData.sortcode;
          }
        }
      }

      handleTrackStats() {
        const affiliateCode = this.affiliateInput.value.trim();
        
        if (!affiliateCode) {
          alert('Please enter your affiliate code');
          return;
        }

        this.trackButton.disabled = true;
        this.inputSection.style.display = 'none';
        this.loadingSection.classList.add('active');

        setTimeout(() => {
          this.loadingSection.classList.remove('active');
          this.dashboard.classList.add('active');
          this.loadDashboardData(affiliateCode);
        }, {{ block.settings.loading_duration | times: 1000 }});
      }

      loadDashboardData(affiliateCode) {
        const savedData = this.getStoredData(affiliateCode);
        
        if (savedData && savedData.account && savedData.sortcode) {
          this.accountInput.value = savedData.account;
          this.sortcodeInput.value = savedData.sortcode;
          this.payoutSaved.classList.add('active');
        }

        this.renderChart();
      }

      renderChart() {
        const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
        const views = [2, 3, 1, 4, 2, 5, 3];
        const maxViews = Math.max(...views);

        this.chart.innerHTML = '';
        this.chartLabels.innerHTML = '';

        views.forEach((view, index) => {
          const height = (view / maxViews) * 100;
          const bar = document.createElement('div');
          bar.className = 'ai-affiliate-hub__chart-bar-{{ ai_gen_id }}';
          bar.style.height = height + '%';
          
          const tooltip = document.createElement('div');
          tooltip.className = 'ai-affiliate-hub__chart-tooltip-{{ ai_gen_id }}';
          tooltip.textContent = view + ' views';
          
          bar.appendChild(tooltip);
          this.chart.appendChild(bar);

          const label = document.createElement('div');
          label.className = 'ai-affiliate-hub__chart-label-{{ ai_gen_id }}';
          label.textContent = days[index];
          this.chartLabels.appendChild(label);
        });
      }

      handlePayoutInput() {
        const affiliateCode = this.affiliateInput.value.trim();
        const account = this.accountInput.value.trim();
        const sortcode = this.sortcodeInput.value.trim();

        if (affiliateCode && account && sortcode) {
          this.savePayoutData(affiliateCode, account, sortcode);
          this.payoutSaved.classList.add('active');
        } else {
          this.payoutSaved.classList.remove('active');
        }
      }

      savePayoutData(affiliateCode, account, sortcode) {
        const allData = JSON.parse(localStorage.getItem(this.storageKey) || '{}');
        allData[affiliateCode] = { account, sortcode };
        localStorage.setItem(this.storageKey, JSON.stringify(allData));
      }

      getStoredData(affiliateCode) {
        const allData = JSON.parse(localStorage.getItem(this.storageKey) || '{}');
        return allData[affiliateCode] || null;
      }
    }

    customElements.define('affiliate-hub-{{ ai_gen_id }}', AffiliateHub{{ ai_gen_id }});
  })();
</script>

