{% doc %}
  @prompt
    Generate an affiliate hub. Basically, it's a UI where the user will input their affiliate link, there is a customisable button with a nice shadow glow and pulsating icon that has text 'track your stats', then an input for the affiliate link, with the first part of the URL pre-filled as 'www.sixxo.uk', then you can put the second part in yourself. then there's going to be a 5-10 second fake green loading button, that then pops up with a statistics dashboard showing 10 views, but 0 sales, and other affiliate related stats on a dynamic graph that the user can interact with. This stays until they refresh the page, but is mobile friendly and I can customise a lot myself., make it so the www.sixxo.uk/ part cannot be edited by the user. the track your stats button is below the enter your affiliate code part, and once loaded, you've generated me a dashboard including views, sales, click through rate and estimated earnings. like a nice UI dashboard you generate for me.
    
    Make it so that the user enters his own affiliate code. once that code has been entered, the data entered after is tied to it and saved. in the dashboard's UI, there should be an entry point for them to 'lock in' their bank account and sort code for 'payouts' / also have a banner at the top indicating that they will get 50% for each sale made from their affiliate link.
    
    The payout area should be autosaved for each individual URL that the user enters, then when they re-enter their sublink it comes up again showing as saved. The payout area should also have some more customisation and a card icon there, to indicate it's about payouts.
    
    Make sure that once the initial button is pressed, (track your stats) it disappears once pressed and the dashboard is shown.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-affiliate-hub-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 20px;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-affiliate-hub__banner-{{ ai_gen_id }} {
    background: {{ block.settings.banner_bg_color }};
    color: {{ block.settings.banner_text_color }};
    padding: 16px 20px;
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
    font-size: {{ block.settings.banner_font_size }}px;
    font-weight: 600;
    margin-bottom: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-affiliate-hub__input-section-{{ ai_gen_id }} {
    margin-bottom: 24px;
  }

  .ai-affiliate-hub__label-{{ ai_gen_id }} {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin-bottom: 8px;
  }

  .ai-affiliate-hub__url-input-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: 2px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    overflow: hidden;
    background: {{ block.settings.input_bg_color }};
    margin-bottom: 20px;
  }

  .ai-affiliate-hub__url-prefix-{{ ai_gen_id }} {
    padding: 12px 16px;
    background: {{ block.settings.prefix_bg_color }};
    color: {{ block.settings.prefix_text_color }};
    font-weight: 600;
    font-size: 14px;
    border-right: 2px solid {{ block.settings.input_border_color }};
    white-space: nowrap;
  }

  .ai-affiliate-hub__url-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 12px 16px;
    border: none;
    outline: none;
    font-size: 14px;
    background: transparent;
    color: {{ block.settings.text_color }};
  }

  .ai-affiliate-hub__track-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 24px;
    background: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    box-shadow: 0 4px 16px {{ block.settings.button_shadow_color }};
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .ai-affiliate-hub__track-button-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px {{ block.settings.button_shadow_color }};
  }

  .ai-affiliate-hub__track-button-{{ ai_gen_id }}:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ai-affiliate-hub__button-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    animation: ai-affiliate-pulse-{{ ai_gen_id }} 2s ease-in-out infinite;
  }

  @keyframes ai-affiliate-pulse-{{ ai_gen_id }} {
    0%, 100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.1);
      opacity: 0.8;
    }
  }

  .ai-affiliate-hub__loading-{{ ai_gen_id }} {
    display: none;
    text-align: center;
    padding: 40px 20px;
  }

  .ai-affiliate-hub__loading-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-affiliate-hub__loading-spinner-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border: 4px solid {{ block.settings.loading_bg_color }};
    border-top-color: {{ block.settings.loading_color }};
    border-radius: 50%;
    animation: ai-affiliate-spin-{{ ai_gen_id }} 1s linear infinite;
    margin: 0 auto 16px;
  }

  @keyframes ai-affiliate-spin-{{ ai_gen_id }} {
    to { transform: rotate(360deg); }
  }

  .ai-affiliate-hub__loading-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 16px;
    font-weight: 600;
  }

  .ai-affiliate-hub__dashboard-{{ ai_gen_id }} {
    display: none;
  }

  .ai-affiliate-hub__dashboard-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-affiliate-hub__stats-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .ai-affiliate-hub__stat-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_bg_color }};
    padding: 20px;
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-affiliate-hub__stat-label-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.label_color }};
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }

  .ai-affiliate-hub__stat-value-{{ ai_gen_id }} {
    font-size: 28px;
    font-weight: 700;
    color: {{ block.settings.value_color }};
  }

  .ai-affiliate-hub__chart-container-{{ ai_gen_id }} {
    background: {{ block.settings.card_bg_color }};
    padding: 24px;
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    border: 1px solid {{ block.settings.card_border_color }};
    margin-bottom: 24px;
  }

  .ai-affiliate-hub__chart-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin-bottom: 20px;
  }

  .ai-affiliate-hub__chart-{{ ai_gen_id }} {
