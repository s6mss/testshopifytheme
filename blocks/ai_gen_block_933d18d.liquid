  }

  .ai-affiliate-hub__chart-bar-{{ ai_gen_id }}:hover {
    background: {{ block.settings.chart_bar_hover_color }};
    transform: translateY(-4px);
  }

  .ai-affiliate-hub__chart-tooltip-{{ ai_gen_id }} {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: {{ block.settings.tooltip_bg_color }};
    color: {{ block.settings.tooltip_text_color }};
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    margin-bottom: 8px;
  }

  .ai-affiliate-hub__chart-bar-{{ ai_gen_id }}:hover .ai-affiliate-hub__chart-tooltip-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-affiliate-hub__chart-labels-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-around;
    margin-top: 12px;
    padding: 0 10px;
  }

  .ai-affiliate-hub__chart-label-{{ ai_gen_id }} {
    flex: 1;
    text-align: center;
    font-size: 11px;
    color: {{ block.settings.label_color }};
  }

  .ai-affiliate-hub__payout-section-{{ ai_gen_id }} {
    background: {{ block.settings.payout_bg_color }};
    padding: 24px;
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-affiliate-hub__payout-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .ai-affiliate-hub__payout-icon-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    color: {{ block.settings.payout_icon_color }};
  }

  .ai-affiliate-hub__payout-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
  }

  .ai-affiliate-hub__payout-form-{{ ai_gen_id }} {
    display: grid;
    gap: 16px;
  }

  .ai-affiliate-hub__payout-input-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 14px;
    background: {{ block.settings.input_bg_color }};
    color: {{ block.settings.text_color }};
    outline: none;
    transition: border-color 0.3s ease;
  }

  .ai-affiliate-hub__payout-input-{{ ai_gen_id }}:focus {
    border-color: {{ block.settings.button_bg_color }};
  }

  .ai-affiliate-hub__payout-saved-{{ ai_gen_id }} {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: {{ block.settings.success_bg_color }};
    color: {{ block.settings.success_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
  }

  .ai-affiliate-hub__payout-saved-{{ ai_gen_id }}.active {
    display: flex;
  }

  @media screen and (max-width: 749px) {
    .ai-affiliate-hub-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-affiliate-hub__stats-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-affiliate-hub__stat-value-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-affiliate-hub__url-prefix-{{ ai_gen_id }} {
      font-size: 12px;
      padding: 12px;
    }

    .ai-affiliate-hub__chart-{{ ai_gen_id }} {
      height: 150px;
    }
